    {
      "submissionId": "SUB-2026-003",
      "registrationId": "SBW-2026-003",
      "eventId": "waste-hunt",
      "eventTitle": "Waste Hunt",
      "teamName": "EcoDetectives",
      "leaderName": "Kunal Shinde",
      "leaderPrn": "72005421A",
      "leaderEmail": "kunal.shinde@moderncoe.edu.in",
      "leaderPhone": "9876500005",
      "branch": "Mechanical Engineering",
      "year": "Final Year (BE)",
      "division": "Div A",
      "submissionTitle": "Campus Comprehensive Cleanliness & Drainage Audit",
      "conceptNote": "Detailed audit across Zones A, B, C, D, and E with 5 concrete engineering findings, root causes, and low-cost implementable solutions.",
      "googleDrivePath": "SWACHH BHARAT WEEK 2026/03_WASTE_HUNT/SBW-2026-003_EcoDetectives",
      "wasteHuntFindings": [
        {
          "findingNumber": 1,
          "title": "Plastic Cup Accumulation Near Water Dispensers",
          "zone": "ZONE A - Main Academic Building",
          "specificLocation": "Ground Floor East Corridor Water Cooler",
          "problemDescription": "Single-use paper and thin plastic cups overflowing from small open bin, spilling onto the polished corridor tiles.",
          "identifiedCause": "High foot-traffic during recess with an undersized 15-litre bin and lack of a designated dry cup stacking cylinder.",
          "proposedSolution": "Install a wall-mounted dual-cylinder cup dispenser and gravity cup stacker next to the water cooler, reducing bin volume occupancy by 80%."
        },
        {
          "findingNumber": 2,
          "title": "Food Packaging Leachate Near Canteen Stormwater Drain",
          "zone": "ZONE B - Canteen Surroundings",
          "specificLocation": "South Outer Wall near Wash Basins",
          "problemDescription": "Oily wet wrapper debris clogging the stainless steel drain grill, producing foul smell during peak lunch hour.",
          "identifiedCause": "Students rinsing plates directly into open handwash sink without a pre-rinse food scrap strainer.",
          "proposedSolution": "Add a pedal-operated wet waste scraper hopper and mesh trap with fine grease filter before the external storm drain."
        },
        {
          "findingNumber": 3,
          "title": "Dry Leaf Litter Blocking Botanical Garden Pathway",
          "zone": "ZONE C - Botanical Garden",
          "specificLocation": "Central Lawn Walkway Boundary",
          "problemDescription": "Fallen foliage and twigs blown across walking pavement rather than being directed to compost beds.",
          "identifiedCause": "Absence of low-height perimeter shrub borders to retain fallen biomass within garden soil beds.",
          "proposedSolution": "Construct a 10-inch eco-brick green kerb border and deploy 2 perforated leaf-mulching wire cylinders for rapid on-site compost conversion."
        },
        {
          "findingNumber": 4,
          "title": "Stray Parking Receipts & Pamphlets near Gate 2",
          "zone": "ZONE D - Parking Areas",
          "specificLocation": "Two-Wheeler Entry Ramp & Security Kiosk",
          "problemDescription": "Discarded paper slips scattered between parked bike tyres due to wind currents.",
          "identifiedCause": "Lack of a disposal box positioned within driver arm-reach at the exit barrier.",
          "proposedSolution": "Mount a bright blue weatherproof drop-slot bin directly on the exit boom barrier pole with a 'Drop Slips Here' decal."
        },
        {
          "findingNumber": 5,
          "title": "Adhesive Tape Residue on Amphitheatre Columns",
          "zone": "ZONE E - Student Common Areas",
          "specificLocation": "Quadrangle Pillar Rows 3 & 4",
          "problemDescription": "Old duct tape and dried gum from past event notices attracting dust and disfiguring stone pillars.",
          "identifiedCause": "Event clubs pasting posters directly onto masonry instead of using designated magnetic notice grids.",
          "proposedSolution": "Erect four standardized brushed-metal magnetic bulletin boards with transparent acrylic covers, strictly banning direct taping."
        }
      ],
      "submittedAt": "2026-10-16T14:15:00.000Z",
      "updatedAt": "2026-10-16T14:15:00.000Z",
